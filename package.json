{
  "name": "the-reserve",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "db:types": "supabase gen types typescript --linked > shared/types/database.ts",
    "db:push": "supabase db push && npm run db:types && npm run db:docs",
    "db:migrations": "supabase migration list",
    "db:docs": "dotenv -e .env -- tbls doc --force -c .tbls.yml",
    "verify:ask": "node scripts/verify-ask.mjs",
    "verify:presets": "node --experimental-strip-types scripts/verify-presets.mjs",
    "verify:forms": "node scripts/verify-forms.mjs",
    "e2e:forms": "node scripts/e2e-forms.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@nuxt/icon": "^2.4.1",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia/nuxt": "^1.0.1",
    "@stripe/stripe-js": "^9.14.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/nuxt": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^1.0.0",
    "motion-v": "^2.3.0",
    "nuxt": "4.5.0",
    "pg": "^8.23.0",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "stripe": "^22.5.0",
    "tailwind-variants": "^3.3.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/testing": "^2.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.6",
    "@yuta-inoue-ph/nuxt-vcalendar": "^1.1.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.0.11",
    "nuxt-gtag": "^4.1.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}

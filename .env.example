# The single env file lives at apps/reserve/.env (gitignored): Nuxt reads it
# there, and the root db:* and verify:* scripts load it from that path.

# Supabase (find these in your Supabase project: Settings > API)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# Server-only secret key (sb_secret_...). Only needed for admin operations
# in server/ code via serverSupabaseServiceRole(). Never expose client-side.
# NUXT_SUPABASE_SECRET_KEY=your-secret-key
NUXT_SUPABASE_SECRET_KEY=

# Public address of THIS deployment, used to build links in outbound email
# (the cancel link today; the reminders' links in phase 3). Leave unset in
# dev — routes fall back to their own request origin.
NUXT_PUBLIC_SITE_URL=

# Bearer secret for the scheduled communications route
# (POST /api/jobs/communications). Generate with: openssl rand -hex 32.
# The SAME value goes into Supabase Vault as communications_job_secret so
# pg_cron can present it. Absent, the route refuses to serve.
COMMUNICATIONS_JOB_SECRET=

# Resend webhook signing secret (marketing campaigns, phase 2): the
# whsec_… value shown on the webhook in the Resend dashboard, which POSTs
# campaign engagement events to /api/webhooks/resend. Absent, the route
# refuses to serve (503). Recorded in Supabase Vault as
# resend_webhook_secret alongside the other secrets, but READ from here:
# server routes cannot reach Vault.
RESEND_WEBHOOK_SECRET=

RESEND_API_KEY=
MAIL_FROM=

TBLS_DSN=

STRIPE_SECRET_KEY=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Ask The Reserve (⌘I). The question and the schema description are sent
# to Anthropic to generate SQL; result rows are never sent.
ANTHROPIC_API_KEY=

# Generated SQL runs on this connection, whose session user is ask_readonly
# (SELECT on an allowlist, read-only, 10s timeout). That session user IS the
# safety boundary — never point this at postgres, service_role, or any role
# with memberships. Set the password after applying the ask_readonly_role
# migration:  alter role ask_readonly with password '<generated>';
ASK_DATABASE_URL=

# Keyed-hash secret for public form-submission attempt logging (rate limits).
# Any long random string; generate with: openssl rand -hex 32
# Server-only. Without it the public submission route refuses to serve,
# rather than degrading to a reversible hash of visitor IPs.
FORM_IP_PEPPER=

# Public lead capture (POST /api/public/leads, called by the marketing site).
# A landing-page submission carries no session and no token, so the org a
# lead belongs to is set HERE, server-side — never taken from the request.
# Single-org today; absent, the route refuses to serve.
LEADS_ORGANIZATION_ID=
# Exact origins allowed to POST from a browser, comma-separated — the
# marketing site's origin(s), e.g. https://www.thereserve.example. Never `*`.
# Absent, no cross-origin caller is allowed (server-to-server still works).
LEADS_ALLOWED_ORIGINS=

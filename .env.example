# Supabase (find these in your Supabase project: Settings > API)
NUXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-publishable-key

# Server-only secret key (sb_secret_...). Only needed for admin operations
# in server/ code via serverSupabaseServiceRole(). Never expose client-side.
# NUXT_SUPABASE_SECRET_KEY=your-secret-key
NUXT_SUPABASE_SECRET_KEY=

RESEND_API_KEY=
MAIL_FROM=

TBLS_DSN=

STRIPE_SECRET_KEY=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Ask The Reserve (⌘I). The question and the schema description are sent
# to Anthropic to generate SQL; result rows are never sent.
ANTHROPIC_API_KEY=

# Generated SQL runs on this connection, whose session user is ask_readonly
# (SELECT on an allowlist, read-only, 10s timeout). That session user IS the
# safety boundary — never point this at postgres, service_role, or any role
# with memberships. Set the password after applying the ask_readonly_role
# migration:  alter role ask_readonly with password '<generated>';
ASK_DATABASE_URL=

# Keyed-hash secret for public form-submission attempt logging (rate limits).
# Any long random string; generate with: openssl rand -hex 32
# Server-only. Without it the public submission route refuses to serve,
# rather than degrading to a reversible hash of visitor IPs.
FORM_IP_PEPPER=
